# Copy this file to .env and fill in real values. Never commit .env.

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Database (filled in when we add Postgres in a later module)
DATABASE_URL=postgresql://ap_user:ap_password@localhost:5432/ap_suite

# Invoice mailbox (Gmail) - filled in when we wire ingestion
AP_MAILBOX_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Confidence threshold for auto-processing (below this, route to AP queue)
CONFIDENCE_THRESHOLD=0.90
